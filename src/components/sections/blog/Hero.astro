---

interface Props {
  title: string;
  description: string;
  image: string;
}

const { title, description, image } = Astro.props;
---

<div class="hero-banner" style={{ '--hero-image': `url(${image})` }}>
  <div class="text-center text-white">
    <h1 class="text-4xl md:text-6xl text-shadow font-bold">{title}</h1>
    <p class="text-2xl md:text-4xl font-light mt-0.5">{description}</p>
  </div>
</div>

<style>
  .hero-banner {
    height: 45vh; 
    width: 100%;
    background-image: 
        linear-gradient(to bottom, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 1) 100%),
        var(--hero-image);
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    box-sizing: border-box;
  }
</style>
