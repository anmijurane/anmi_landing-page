---
import Button from "@components/Button.astro";
import Section from "@components/Section.astro";
---

<section class="flex flex-col items-center gap-8 mb-28 reveal" id="contact">
  <h2 class="text-theme-primary text-5xl font-bold tracking-tight mb-4">
    ¿Interesado?
  </h2>
  <p class="text-gray-500 text-center w-1/2 text-xl">
    La tecnología es el medio, la solución es el objetivo. Estoy listo para
    aportar mi experiencia en desarrollo web para materializar tu visión.
    Cuéntame sobre tu proyecto y pongámonos manos a la obra.
  </p>
  <Button size="xl" variant="primary">Iniciemos conversación</Button>
</section>
