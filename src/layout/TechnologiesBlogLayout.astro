---
import Header from '@components/Header.astro';
import Hero from '@components/sections/blog/Hero.astro';
import MainLayout from '@layouts/MainLayout.astro';

interface Props {
  heroUrl: string;
  title: string;
  description: string;
  themeColor?: string;
}

const { heroUrl, title, description, themeColor } = Astro.props;
---

<MainLayout themeColor={themeColor}>
  <Header />
  <div class="w-full bg-cover bg-center bg-no-repeat h-[500px] overflow-hidden flex justify-center items-center">
    <Hero title={title} description={description} image={heroUrl} />
  </div>
  <slot />
</MainLayout>
