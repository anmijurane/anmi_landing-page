---
import '@styles/main.css';

const TITLE = 'Andres Jurado - Desarrollador Web';

interface Props {
  themeColor?: string;
}

const { themeColor = 'var(--color-cyan-400)' } = Astro.props;
---

<!doctype html>
<html lang="es" style={`--color-theme-primary: ${themeColor}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Andres Jurado - Desarrollador Web" />
    <meta
      name="keywords"
      content="Andres Jurado, Desarrollador Web, Desarrollador Frontend, Desarrollador Backend, Desarrollador Fullstack"
    />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="author" content="Andres Jurado" />
    <meta name="robots" content="index, follow" />
    <title>{TITLE}</title>
  </head>
  <body class="leading-relaxed">
    <div id="custom-cursor"></div>
    <main>
      <slot />
    </main>
  </body>
</html>

<script>
  import { cursorPointer } from "@scripts/cursor";
  import { scrollObserver } from "@scripts/scrollObserver";
  import { scrollSpyNav } from "@scripts/scrollSpyNav";

  const __init__ = () => {
    cursorPointer();
    scrollObserver();
    scrollSpyNav();
  };

  document.addEventListener("DOMContentLoaded", __init__);
</script>
