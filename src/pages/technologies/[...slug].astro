---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import type { Collection } from '@app-types/blog';
import AsideBlog from '@components/AsideBlog.astro';
import DateSvg from '@components/DateSvg.astro';
import LineSeparator from '@components/LineSeparator.astro';
import TechnologiesBlogLayout from '@layouts/TechnologiesBlogLayout.astro';
import '@styles/markdown.css';

import dayjs from 'dayjs';
import relativeTime from 'dayjs/plugin/relativeTime';
import utc from 'dayjs/plugin/utc';

dayjs.extend(relativeTime);
dayjs.extend(utc);

export async function getStaticPaths() {
  const technologies = await getCollection('technologies');
  return technologies
    .filter((technology: CollectionEntry<'technologies'>) => !technology.data.isDraft)
    .map((technology: CollectionEntry<'technologies'>) => {
      return {
        params: { slug: technology.id },
        props: {
          technology,
          collections: technologies
            .filter((t: CollectionEntry<'technologies'>) => !t.data.isDraft)
            .map((t: CollectionEntry<'technologies'>) => ({
              slug: t.id,
              title: t.data.title,
              date: t.data.pubDate,
              heroUrl: t.data.heroImage || '',
              icon: t.data.icon || '',
              category: t.data.category,
              color: t.data.color || 'var(--color-cyan-400)',
            })),
        },
      };
    });
}

interface Props {
  technology: CollectionEntry<'technologies'>;
  collections: Collection[];
}

const { technology, collections } = Astro.props;
const { slug } = Astro.params;

const { Content } = await render(technology);

const now = dayjs();
const relativeDate = dayjs(technology.data.pubDate).locale('es').from(now);
---

<TechnologiesBlogLayout
  heroUrl={technology.data.heroImage || ''}
  title={technology.data.title}
  description={technology.data.description}
  themeColor={technology.data.color}
>
  <div class="flex flex-col md:flex-row">
    <div class="flex md:w-4/12 lg:w-3/12 mt-4 md:mt-0 px-6 md:pl-6 relative top-0 md:-top-10 lg:-top-20 h-fit">
      <AsideBlog collections={collections} slug={slug} />
    </div>
    <div class="w-full md:w-8/12 lg:w-9/12 px-4">
      <div class="markdown-content">
        <Content />
      </div>
      <LineSeparator size="8" />
      <div class="flex flex-col items-center w-full">
        <DateSvg date={technology.data.pubDate} size="60px" />
        <p>{relativeDate}</p>
      </div>
    </div>
  </div>
</TechnologiesBlogLayout>
